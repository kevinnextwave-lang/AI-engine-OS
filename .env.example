# ---------------------------------------------------------------------------
# AI Search Growth OS — environment template. Copy to .env; never commit .env.
# Placeholders only. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# Backend (apps/api) ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_search_growth_os
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CORS_ORIGINS=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend (apps/web) --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# docker-compose (Postgres container) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_search_growth_os
