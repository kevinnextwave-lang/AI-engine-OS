# Application
# development | test | production
APP_ENV=development
APP_NAME="AI Search Growth OS API"
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_search_growth_os

# Redis (rate limiting, Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookies for refresh token
# Set COOKIE_SECURE=true in production (HTTPS). COOKIE_DOMAIN empty = host-only.
# COOKIE_SAMESITE: lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Stripe (Milestone 1 only wires config; billing comes later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Crawler
CRAWL_USER_AGENT="AI-Search-Growth-OS-Crawler/1.0 (+https://aisearchgrowth.example/crawler)"
CRAWL_CONCURRENCY=5
CRAWL_REQUESTS_PER_SECOND=2
CRAWL_DEFAULT_MAX_PAGES=200
CRAWL_DEFAULT_MAX_DEPTH=5
CRAWL_MAX_RESPONSE_BYTES=5242880
CRAWL_ALLOW_SUBDOMAINS=false
# none | local  (object storage adapter comes later)
CRAWL_HTML_STORAGE=none
CRAWL_HTML_STORAGE_PATH=./var/crawl-html

# AI providers (Milestone 3A). Keys stay server-side; never sent to the frontend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash
AI_DEFAULT_TIMEOUT_SECONDS=60
AI_DEFAULT_MAX_TOKENS=1024
# Store generated text in ai_generations (set false to keep only metadata)
AI_STORE_RESPONSE_TEXT=true

# Prompt execution (Milestone 3C)
AI_RUN_MAX_ATTEMPTS=4
AI_RUN_RETRY_BASE_SECONDS=5
AI_RUN_RETRY_MAX_SECONDS=300
AI_RATE_LIMIT_OPENAI_PER_MINUTE=60
AI_RATE_LIMIT_ANTHROPIC_PER_MINUTE=50
AI_RATE_LIMIT_GOOGLE_PER_MINUTE=60
AI_RUN_MAX_TOKENS=1024
AI_RUN_TEMPERATURE=0.2
